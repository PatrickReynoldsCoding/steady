<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="How was today?" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/neutral" android:paddingBottom="8dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/rate_good" style="@style/RateButton" android:text="Good"
            android:background="@drawable/rate_good" android:textColor="@color/ok" />
        <TextView android:id="@+id/rate_okay" style="@style/RateButton" android:text="Okay"
            android:background="@drawable/rate_okay" android:textColor="@color/neutral" />
        <TextView android:id="@+id/rate_bad" style="@style/RateButton" android:text="Bad"
            android:background="@drawable/rate_bad" android:textColor="@color/warn" />
        <TextView android:id="@+id/rate_crash" style="@style/RateButton" android:text="Crash"
            android:background="@drawable/rate_crash" android:textColor="@color/stop" />
    </LinearLayout>
</LinearLayout>
